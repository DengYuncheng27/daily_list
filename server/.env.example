# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required; the service refuses an empty, short, or REPLACE-prefixed secret.
DAYFLOW_JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
DAYFLOW_DATABASE_PATH=/data/dayflow.sqlite3
# Comma-separated origins, no trailing slash. Native clients do not require CORS.
DAYFLOW_ALLOWED_ORIGINS=https://planner.example.com
# Enable briefly for initial sign-up, then disable and restart if serving a family/team.
DAYFLOW_REGISTRATION_ENABLED=false
DAYFLOW_AUTH_RATE_LIMIT=20
DAYFLOW_SYNC_RATE_LIMIT=120
DAYFLOW_ATTACHMENT_DIRECTORY=/data/attachments
DAYFLOW_ATTACHMENT_MAX_BYTES=10485760
DAYFLOW_ATTACHMENT_QUOTA_BYTES=104857600
