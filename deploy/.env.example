DAYFLOW_DOMAIN=planner.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DAYFLOW_JWT_SECRET=REPLACE_WITH_YOUR_RANDOM_SECRET
# Enable while creating your accounts; disable afterwards if this is private.
DAYFLOW_REGISTRATION_ENABLED=false
# Attachment limits in bytes: 10 MiB/file, 100 MiB/account by default.
DAYFLOW_ATTACHMENT_MAX_BYTES=10485760
DAYFLOW_ATTACHMENT_QUOTA_BYTES=104857600
# Dedicated internal API network; change both values if this subnet overlaps
# your host/VPN networks. Never set DAYFLOW_PROXY_IP to "*" or a CIDR.
DAYFLOW_PROXY_SUBNET=172.30.72.0/29
DAYFLOW_PROXY_IP=172.30.72.3
